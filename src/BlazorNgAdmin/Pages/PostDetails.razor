@page "/posts/{id:int}"
@using BlazorNgAdmin.Models
@using BlazorNgAdmin.Services
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Post Details</PageTitle>

<h1>Post Details</h1>

@if (isLoading)
{
    <p><em>Loading post...</em></p>
}
else if (post == null)
{
    <p><em>Post not found.</em></p>
}
else
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@post.Title</h5>
            <h6 class="card-subtitle mb-2 text-muted">Post ID: @post.Id | User ID: @post.UserId</h6>
            <p class="card-text">@post.Body</p>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="GoBack">Back to List</button>
        <button class="btn btn-warning" @onclick="EditPost">Edit</button>
    </div>

    <h3 class="mt-4">Comments</h3>
    @if (isLoadingComments)
    {
        <p><em>Loading comments...</em></p>
    }
    else if (comments == null || comments.Count == 0)
    {
        <p><em>No comments found.</em></p>
    }
    else
    {
        <div class="list-group">
            @foreach (var comment in comments)
            {
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1">@comment.Name</h6>
                        <small>@comment.Email</small>
                    </div>
                    <p class="mb-1">@comment.Body</p>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Post? post;
    private List<Comment>? comments;
    private bool isLoading = true;
    private bool isLoadingComments = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPost();
        await LoadComments();
    }

    private async Task LoadPost()
    {
        isLoading = true;
        try
        {
            post = await ApiService.GetPostAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading post: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadComments()
    {
        isLoadingComments = true;
        try
        {
            comments = await ApiService.GetPostCommentsAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading comments: {ex.Message}");
        }
        finally
        {
            isLoadingComments = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/posts");
    }

    private void EditPost()
    {
        Navigation.NavigateTo($"/posts/{Id}/edit");
    }
}
